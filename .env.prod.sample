# ============================================================
# Kenyan Fantasy League — Production environment
# Domain: fantasykenya.com
# Copy to .env.prod and replace every placeholder secret.
# Loaded by: docker compose --env-file .env.prod (Makefile)
#            + env_file: injection into api/celery containers
# ============================================================

# ---------- Django core ----------
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REPLACE_ME_LONG_RANDOM_STRING
# WARNING: code does os.getenv("DEBUG") raw — ANY non-empty string (even "False") enables debug.
# Leave EMPTY for production.
DEBUG=
ALLOWED_HOSTS=fantasykenya.com,www.fantasykenya.com,api.fantasykenya.com

# JWT signing key (SimpleJWT) — generate: openssl rand -hex 32
SIGNING_KEY=REPLACE_ME_64_HEX_CHARS

# ---------- Postgres ----------
# Required at container boot — entrypoint hard-fails without these five.
# ${PG_USER}/${PG_PASSWORD}/${POSTGRES_DB} are also interpolated into the
# postgres-db service in docker-compose files, so they MUST be set here.
PG_ENGINE=django.db.backends.postgresql
POSTGRES_DB=fpl
PG_USER=root
PG_PASSWORD=REPLACE_ME_STRONG_DB_PASSWORD
PG_HOST=postgres-db
PG_PORT=5432

# ---------- Email / SMTP (djcelery_email backend, TLS forced) ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@fantasykenya.com
EMAIL_HOST_PASSWORD=REPLACE_ME_SMTP_APP_PASSWORD
# Used to build links inside emails
DOMAIN=fantasykenya.com

# ---------- Celery (Redis broker/backend; cache separately uses redis://redis:6379/1 hardcoded) ----------
CELERY_BROKER=redis://redis:6379/0
CELERY_BACKEND=redis://redis:6379/0

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_ME
# Authorized redirect URI to register in Google Console:
#   https://fantasykenya.com/accounts/google/callback/
# (adjust to your frontend route)

# ---------- Scraping / feature flags ----------
LINEUPS_SCRAPING_ENABLED=false
PRIMARY_LINEUP_SOURCE=fkf
SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub
LINEUP_SCRAPER_MAX_CONCURRENCY=2
SCRAPER_USER_AGENT=kenyan-fantasy-league/lineups-scraper

# ---------- Scraper source URLs ----------
TABLE_STANDINGS_URL=https://example-source.com/kpl/table
TEAM_FIXTURES_URL=https://example-source.com/kpl/fixtures
MATCHES_URL=https://example-source.com/kpl/live
TEAM_LOGOS_URL=https://example-source.com/kpl/logos

# Per-team squad pages (one per KPL club, keys consumed by apps/kpl/tasks/players.py)
AFC_LEOPARDS_URL=
BANDARI_URL=
GOR_MAHIA_URL=
KCB_URL=
KAKAMEGA_HOMEBOYZ_URL=
KARIOBANGI_SHARKS_URL=
MARA_SUGAR_URL=
MATHARE_UNITED_URL=
MURANGA_SEAL_URL=
POLICE_URL=
POSTA_RANGERS_URL=
SHABANA_URL=
SOFAPAKA_URL=
TALANTA_URL=
TUSKER_URL=
ULINZI_URL=
NAIROBI_UNITED_URL=

# ---------- Client build args (Vite bakes at build time; axios actually uses relative /api/v1 via nginx) ----------
VITE_MODE=production
VITE_API_BASE_URL=https://fantasykenya.com/api/v1
