SECRET_KEY=
DEBUG=
# Space- or comma-separated hosts Django will serve, e.g.
#   ALLOWED_HOSTS=fantasykenya.com www.fantasykenya.com
# Hostnames only — Django strips the port before matching, so an entry like
# "127.0.0.1:8000" matches nothing at all and every request from that host is
# rejected with a 400.
# Leave blank for local development. In production this must name the real
# domains: unset means "*" (every Host accepted) and blank means none at
# all. config/settings/production.py pins the live domains either way.
ALLOWED_HOSTS=
SIGNING_KEY=

PG_ENGINE=
PG_USER=
PG_PASSWORD=
POSTGRES_DB=
PG_HOST=
PG_PORT=

EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=
DOMAIN=

CELERY_BROKER=
CELERY_BACKEND=

# ============ Scraping sources ============
# No upstream hostname is committed to this repository. The scrapers read every
# source from the variables below; fill them in your local .env / .env.prod.

# Primary source: server-rendered pages covering the whole competition.
SCRAPER_PRIMARY_BASE_URL=
# The competition label exactly as the source writes it, without the season,
# e.g. "Example Premier League" for pages titled "Example Premier League 2026/2027".
SCRAPER_PRIMARY_COMPETITION=
# Comma-separated role=path pairs. {season} and {match} are filled in at request
# time. All eight roles are required:
#   index      competition index, used to discover the current season
#   teams      competing clubs and their badge files
#   standings  the league table
#   fixtures   scheduled matches
#   results    played matches with final scores
#   scorers    the scoring charts
#   squads     every registered squad
#   match      one played match: goals, cards, both lineups
# e.g. index=index.php,teams=teams.php?t={season},...,match=match.php?s={match}
SCRAPER_PRIMARY_PATHS=

# Lineup adapters: comma-separated provider=host pairs, and the order to try
# them in. Only fixtures with a mapped provider match-page URL are fetched.
SCRAPER_PROVIDER_HOSTS=
SCRAPER_LINEUP_PROVIDERS=

# ============ Live match monitor ============
# Used by apps/kpl/tasks/live_games.py, which drives a browser for in-play
# scores. Independent of the sync_* pipeline above, which settles matches from
# the published match report after the final whistle.
MATCHES_URL=

# ============ Celery workers ============
CELERY_WORKER_CONCURRENCY=
# Keep this low — scraping sources are small hosts.
CELERY_SCRAPING_CONCURRENCY=
# Route scraping onto its own queue. Turn on only after rebuilding the images
# with the queue-aware start scripts, otherwise routed tasks have no consumer.
CELERY_SCRAPING_QUEUE_ENABLED=false

