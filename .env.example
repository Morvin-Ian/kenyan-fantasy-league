DEBUG=
# Space- or comma-separated hosts Django will serve, e.g.
#   ALLOWED_HOSTS=fantasykenya.com www.fantasykenya.com
# Leave blank for local development. In production this must name the real
# domains: unset means "*" (every Host accepted) and blank means none at
# all. config/settings/production.py pins the live domains either way.
ALLOWED_HOSTS=
SIGNING_KEY=

PG_ENGINE=
PG_USER=
PG_PASSWORD=
POSTGRES_DB=
PG_HOST=
PG_PORT=

EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=
DOMAIN=

CELERY_BROKER=
CELERY_BACKEND=

# URL of the KPL SportPress fixtures page (must contain table.sp-event-blocks).
TEAM_FIXTURES_URL=