#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

mkdir -p logs

# Run Django management commands
python3 manage.py migrate --no-input
python3 manage.py collectstatic --no-input

exec gunicorn config.wsgi:application \
  --bind 0.0.0.0:8000 \
  --workers "${GUNICORN_WORKERS:-3}" \
  --timeout "${GUNICORN_TIMEOUT:-60}" \
  --access-logfile - \
  --error-logfile -
